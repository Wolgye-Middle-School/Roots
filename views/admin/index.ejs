<%- include('../partials/header', { pageTitle: '관리자' }) %>
<h1>관리자</h1>

<% if (defaultPassword) { %>
  <div class="flash flash-error">
    관리자 계정이 기본 비밀번호(admin)를 사용 중입니다. 보안을 위해 <a href="/account/password">비밀번호를 변경</a>해 주세요.
  </div>
<% } %>

<div class="stats">
  <a class="stat" href="/admin?status=pending#users"><strong><%= counts.pending || 0 %></strong><span>승인 대기</span></a>
  <a class="stat" href="/admin?status=approved#users"><strong><%= counts.approved || 0 %></strong><span>승인 회원</span></a>
  <a class="stat" href="/admin?status=rejected#users"><strong><%= counts.rejected || 0 %></strong><span>거절</span></a>
  <div class="stat"><strong><%= postCount %></strong><span>전체 게시글</span></div>
</div>

<section class="card" id="users">
  <div class="section-head">
    <h2>회원 관리</h2>
    <nav class="tabs">
      <a class="<%= !status ? 'active' : '' %>" href="/admin#users">전체</a>
      <% Object.keys(STATUS_LABELS).forEach(function (s) { %>
        <a class="<%= status === s ? 'active' : '' %>" href="/admin?status=<%= s %>#users"><%= STATUS_LABELS[s] %></a>
      <% }) %>
    </nav>
  </div>
  <p class="muted">가입 신청자가 실제 느티나무반 학부모·교사인지 확인한 후 승인해 주세요. 승인된 회원만 회원 전용 글을 볼 수 있습니다.</p>
  <% if (!users.length) { %><p class="empty">해당하는 회원이 없습니다.</p><% } %>
  <div class="table-wrap">
    <table class="admin-table">
      <% if (users.length) { %>
        <thead><tr><th>이름</th><th>아이디 / 가입경로</th><th>가입일</th><th>상태</th><th>역할</th><th></th></tr></thead>
      <% } %>
      <tbody>
        <% users.forEach(function (u) { var self = u.id === user.id; %>
          <tr>
            <td><strong><%= u.nickname %></strong></td>
            <td><%= u.username || '-' %> <small class="muted">(<%= PROVIDER_LABELS[u.provider] || u.provider %>)</small></td>
            <td><%= formatDate(u.created_at) %></td>
            <td><span class="status status-<%= u.status %>"><%= STATUS_LABELS[u.status] %></span></td>
            <td>
              <% if (self) { %>
                <span class="role role-<%= u.role %>"><%= roleLabel(u.role) %></span>
              <% } else { %>
                <form method="post" action="/admin/users/<%= u.id %>/role" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= status || '' %>">
                  <select name="value" onchange="this.form.submit()" aria-label="역할">
                    <% ['parent', 'teacher', 'admin'].forEach(function (r) { %>
                      <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= roleLabel(r) %></option>
                    <% }) %>
                  </select>
                  <noscript><button type="submit" class="btn btn-small">변경</button></noscript>
                </form>
              <% } %>
            </td>
            <td class="actions">
              <% if (!self) { %>
                <% if (u.status !== 'approved') { %>
                  <form method="post" action="/admin/users/<%= u.id %>/status" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="<%= status || '' %>">
                    <button name="value" value="approved" class="btn btn-small">승인</button>
                  </form>
                <% } %>
                <% if (u.status !== 'rejected') { %>
                  <form method="post" action="/admin/users/<%= u.id %>/status" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="<%= status || '' %>">
                    <button name="value" value="rejected" class="btn btn-small btn-outline">거절</button>
                  </form>
                <% } %>
                <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline-form" onsubmit="return confirm('<%= u.nickname %> 님의 계정과 작성한 글을 모두 삭제하시겠습니까?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= status || '' %>">
                  <button class="btn btn-small btn-danger">삭제</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="card" id="posts">
  <h2>최근 게시글</h2>
  <% if (!posts.length) { %><p class="empty">게시글이 없습니다.</p><% } %>
  <div class="table-wrap">
    <table class="admin-table">
      <tbody>
        <% posts.forEach(function (p) { %>
          <tr>
            <td><span class="muted"><%= p.boardName %></span></td>
            <td><a href="/boards/<%= p.board %>/<%= p.id %>"><%= p.title %></a> <% if (p.visibility === 'members') { %><span class="badge badge-lock">🔒</span><% } %></td>
            <td><%= p.author %></td>
            <td><%= formatDate(p.created_at) %></td>
            <td class="actions">
              <form method="post" action="/boards/<%= p.board %>/<%= p.id %>/delete" class="inline-form" onsubmit="return confirm('게시글을 삭제하시겠습니까?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-small btn-danger">삭제</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/footer') %>
