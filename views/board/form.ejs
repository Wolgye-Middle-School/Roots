<%- include('../partials/header', { pageTitle: pageTitle }) %>
<p class="breadcrumb"><a href="/boards/<%= board.slug %>"><%= board.name %></a></p>
<section class="card">
  <h1><%= pageTitle %></h1>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="<%= action %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="title">제목</label>
      <input type="text" id="title" name="title" value="<%= form.title || '' %>" maxlength="100" required>
    </div>
    <div class="field">
      <label for="content">내용</label>
      <textarea id="content" name="content" maxlength="20000" required><%= form.content || '' %></textarea>
    </div>
    <div class="field">
      <label for="images">사진 첨부 <span class="muted">(최대 <%= maxFiles %>장, 한 장당 5MB · JPG/PNG/GIF/WEBP)</span></label>
      <% if (attachments.length) { %>
        <div class="thumb-grid">
          <% attachments.forEach(function (a) { %>
            <label class="thumb">
              <img src="/files/<%= a.id %>" alt="<%= a.original_name %>">
              <span><input type="checkbox" name="removeImages" value="<%= a.id %>"> 삭제</span>
            </label>
          <% }) %>
        </div>
      <% } %>
      <input type="file" id="images" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple>
      <div class="notice-box">
        학생의 얼굴 등 개인을 알아볼 수 있는 사진은 <strong>보호자의 동의를 받은 경우에만</strong> 올려 주세요.
        <label class="consent"><input type="checkbox" name="photoConsent" value="1" <%= form.photoConsent ? 'checked' : '' %>> 사진 속 학생의 보호자에게 게시 동의를 받았습니다. (사진 첨부 시 필수)</label>
      </div>
    </div>
    <div class="field">
      <label>공개 범위</label>
      <div class="radio-group">
        <label><input type="radio" name="visibility" value="members" <%= form.visibility !== 'public' ? 'checked' : '' %>> 🔒 회원 전용 (승인된 교사·학부모만)</label>
        <label><input type="radio" name="visibility" value="public" <%= form.visibility === 'public' ? 'checked' : '' %>> 전체 공개</label>
      </div>
      <p class="hint">아이의 이름, 학습 현황 등 개인정보가 포함된 글은 반드시 '회원 전용'으로 설정해 주세요.</p>
    </div>
    <% if (canPin) { %>
      <div class="field check">
        <label><input type="checkbox" name="pinned" value="1" <%= form.pinned ? 'checked' : '' %>> 목록 상단에 고정</label>
      </div>
    <% } %>
    <div class="form-actions">
      <a class="btn btn-outline" href="/boards/<%= board.slug %>">취소</a>
      <button type="submit" class="btn">저장</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
