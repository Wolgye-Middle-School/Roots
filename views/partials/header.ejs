<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · ' : '' %>느티나무 게시판</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><span class="brand-mark">🌳</span> 느티나무 게시판</a>
    <nav class="main-nav">
      <% if (typeof boards !== 'undefined') { boards.forEach(function (b) { %>
        <a href="/boards/<%= b.slug %>"><%= b.name %></a>
      <% }) } %>
    </nav>
    <div class="user-nav">
      <% if (user) { %>
        <span class="user-name"><%= user.nickname %> <small class="role role-<%= user.role %>"><%= roleLabel(user.role) %></small></span>
        <% if (user.role === 'admin') { %><a href="/admin">관리자</a><% } %>
        <form action="/logout" method="post" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="link-button">로그아웃</button>
        </form>
      <% } else { %>
        <a href="/login">로그인</a>
        <a href="/signup" class="btn btn-small">회원가입</a>
      <% } %>
    </div>
  </div>
</header>
<main class="container">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
<% } %>
